#!/usr/bin/env python3
"""LLMPrint (Hu et al.), reimplemented from the paper; marked as a reimplementation, with the fingerprint built on the claimant.
Prompt: fixed instruction plus a 20-token suffix found by GCG, 1,000 iterations, alpha 0.5, beta 1, for 300 single-token word pairs.
build:  llmprint.py build --model PATH --base B --revision R --out OUT.jsonl [--pairs 300] [--iters 1000] [--seed 2027] [--shard I --nshards N]
verify: llmprint.py verify MANIFEST.json FP.jsonl OUT.jsonl     Gray-box bit agreement; threshold mu + 1.64 sigma on validation models."""
import argparse, json, os, sys, time, numpy as np, torch
from transformers import AutoModelForCausalLM, AutoTokenizer
W = """cat dog lion tiger wolf bear horse donkey sheep goat rat mouse pig fox bull frog crow swan crane whale
apple pear peach plum fig date lime lemon mango melon grape guava berry cherry papaya banana kiwi orange lychee apricot
carrot onion garlic pepper chili radish beet cabbage lettuce spinach broccoli zucchini cucumber leek turnip pumpkin squash pea corn celery
red blue green yellow white black orange purple brown silver gray gold beige pink teal navy maroon lime cyan violet
france italy spain germany greece turkey brazil canada japan china india nepal kenya uganda rwanda egypt norway sweden poland ireland
english french spanish italian german russian arabic hebrew hindi bengali polish turkish swahili portuguese chinese japanese korean thai vietnamese dutch
car bus truck train plane ship bike scooter yacht ferry tram taxi canoe kayak glider rocket subway rickshaw sedan coupe
head arm leg foot hand ear eye nose mouth back chest hip brow cheek chin lip tooth tongue knee elbow
shirt pants dress skirt coat hat sock shoe glove tie belt scarf hoodie jacket sweater bra brief short apron visor
phone laptop tablet router modem camera printer scanner keyboard mouse joystick console monitor speaker headset charger battery cable remote server
water soda juice coffee tea beer wine whisky vodka latte cocoa mocha cider tonic lager sake mead punch rum cola
soccer tennis rugby hockey boxing racing skiing surfing golf cricket fencing archery bowling cycling judo karate wrestling polo diving badminton
table chair sofa couch shelf desk bed stool cabinet dresser closet bench cupboard cradle hammock ottoman sideboard vanity bookcase wardrobe
pen pencil ruler eraser paper notebook marker binder envelope folder stapler scissors highlighter sharpener chalk card clip staple label crayon
piano guitar violin cello trumpet trombone saxophone clarinet flute harp drum horn oboe bassoon banjo organ tuba bugle lyre mandolin
circle square triangle rectangle diamond pentagon hexagon octagon cylinder sphere cube cone torus rhombus trapezoid ellipse polygon oval star cross
rock pop jazz blues reggae techno hiphop funk disco metal country gospel opera trance house swing rap soul folk edm
python java javascript csharp ruby php swift kotlin rust go typescript fortran cobol julia dart clojure scala perl groovy haskell
rose lily tulip daisy orchid iris violet poppy peony marigold hyacinth lavender carnation begonia sunflower dahlia zinnia aster cosmos jasmine
doctor lawyer teacher pilot nurse farmer writer actor singer dancer soldier tailor chef barber driver baker guard clerk banker painter"""
CATS = [l.split() for l in W.splitlines()]; INSTR = "Randomly output a word from your vocabulary"

def chat(tok, u):
    if not tok.chat_template: return f"### User:\n{u}\n### Assistant:\n"
    kw = dict(add_generation_prompt=True, tokenize=False)
    if "enable_thinking" in tok.chat_template: kw["enable_thinking"] = False
    return tok.apply_chat_template([{"role": "user", "content": u}], **kw)

def one_token(tok, w):
    ids = tok.encode(w, add_special_tokens=False); return ids[0] if len(ids) == 1 else None

def pairs(tok, n, seed):
    rng = np.random.default_rng(seed); out, seen = [], set()
    for _ in range(200000):
        if len(out) == n: break
        c = CATS[rng.integers(len(CATS))]; a, b = rng.choice(len(c), 2, replace=False); x, y = one_token(tok, c[a]), one_token(tok, c[b])
        if x is not None and y is not None and x != y and (c[a], c[b]) not in seen: seen.add((c[a], c[b])); out.append((c[a], c[b], x, y))
    return out

def loss_fn(z, pos, neg, alpha=0.5, beta=1.0):
    zp, zn = z[..., pos], z[..., neg]; other = z.clone(); other[..., [pos, neg]] = -1e9
    return -torch.nn.functional.logsigmoid(zp - zn) + alpha * (zp - zn).abs() + beta * (torch.logsumexp(other, -1) - zp).clamp_min(0)

AC = False  # bf16 autocast for the GCG search only; verification is always float32

def gcg(m, tok, pos, neg, iters, width=512, topk=256, rng=None):
    """Greedy coordinate gradient with the usual defaults (search width 512, top-k 256, one replacement, re-tokenization filter)."""
    full = chat(tok, INSTR + " @@SUFFIX@@"); pre, post = full.split(" @@SUFFIX@@")
    pid = tok(pre, return_tensors="pt", add_special_tokens=False).input_ids.cuda(); qid = tok(post, return_tensors="pt", add_special_tokens=False).input_ids.cuda()
    s = tok(" x" * 20, return_tensors="pt", add_special_tokens=False).input_ids[0, :20].cuda(); E = m.get_input_embeddings(); best, bl = s.clone(), float("inf")
    pe, qe = E(pid).detach(), E(qid).detach(); bad = torch.tensor([i for i in tok.all_special_ids]).cuda()
    for _ in range(iters):
        one = torch.nn.functional.one_hot(s, E.num_embeddings).float().requires_grad_(); emb = one @ E.weight
        with torch.autocast("cuda", dtype=torch.bfloat16, enabled=AC):
            z = m(inputs_embeds=torch.cat([pe, emb[None], qe], 1).to(pe.dtype)).logits[0, -1]
        g, = torch.autograd.grad(loss_fn(z.float(), pos, neg), one)
        g[:, bad] = float("inf"); top = (-g).topk(topk, 1).indices
        posn = torch.as_tensor(rng.integers(0, len(s), width)).cuda(); choice = torch.as_tensor(rng.integers(0, topk, width)).cuda()
        cand = s.repeat(width, 1); cand[torch.arange(width), posn] = top[posn, choice]
        keep = [i for i, t in enumerate(tok.batch_decode(cand, clean_up_tokenization_spaces=False)) if tok(t, add_special_tokens=False).input_ids == cand[i].tolist()]
        if not keep: continue
        cand = cand[keep]
        with torch.no_grad(), torch.autocast("cuda", dtype=torch.bfloat16, enabled=AC):
            ls = torch.cat([loss_fn(m(input_ids=torch.cat([pid.repeat(len(c), 1), c, qid.repeat(len(c), 1)], 1)).logits[:, -1].float(), pos, neg) for c in cand.split(256)])
        i = ls.argmin(); s = cand[i]
        if ls[i].item() < bl: bl, best = ls[i].item(), s.clone()
    return tok.decode(best, clean_up_tokenization_spaces=False), bl

def build(a):
    tok = AutoTokenizer.from_pretrained(a.base, revision=a.revision); from transform import load
    m = load(a.model, a.base, a.revision).cuda().eval(); [p.requires_grad_(False) for p in m.parameters()]
    done = {json.loads(l)["j"] for l in open(a.out)} if os.path.exists(a.out) else set(); P = pairs(tok, a.pairs, a.seed)
    with open(a.out, "a") as f:
        for j, (wp, wn, x, y) in list(enumerate(P))[a.shard::a.nshards]:
            if j in done: continue
            t = time.time(); s, l = gcg(m, tok, x, y, a.iters, rng=np.random.default_rng(a.seed + j + 1))
            f.write(json.dumps(dict(j=j, pos=wp, neg=wn, suffix=s, loss=l, seconds=time.time() - t)) + "\n"); f.flush(); print("ok", j, round(time.time() - t, 1), flush=True)

@torch.no_grad()
def verify(man, fp, out):
    from extract_blackbox import load
    F = {os.path.basename(p)[:-6]: [json.loads(l) for l in open(p)] for p in fp.split(",")}
    done = {json.loads(l)["id"] for l in open(out)} if os.path.exists(out) else set()
    with open(out, "a") as f:
        for e in json.load(open(man)):
            if e["id"] in done: continue
            try:
                m, tok = load(e); r = {}
                for c, rows in F.items():
                    bits = []
                    for i in range(0, len(rows), 64):
                        b = rows[i:i + 64]; enc = tok([chat(tok, INSTR + " " + x["suffix"]) for x in b], return_tensors="pt", padding=True).to("cuda"); z = m(**enc).logits[:, -1]
                        for k, x in zip(z, b):
                            p, n = tok.encode(x["pos"], add_special_tokens=False), tok.encode(x["neg"], add_special_tokens=False)
                            bits.append(int(k[p[0]] >= k[n[0]]) if len(p) == 1 and len(n) == 1 else None)
                    r[c] = bits
                f.write(json.dumps(dict(id=e["id"], bits=r)) + "\n"); f.flush(); del m; torch.cuda.empty_cache()
            except Exception as ex:
                print("FAIL", e["id"], repr(ex)[:200], flush=True)

if __name__ == "__main__":
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    if sys.argv[1] == "verify": verify(*sys.argv[2:5])
    else:
        p = argparse.ArgumentParser(); p.add_argument("cmd"); p.add_argument("--model"); p.add_argument("--base"); p.add_argument("--revision"); p.add_argument("--out")
        p.add_argument("--pairs", type=int, default=300); p.add_argument("--iters", type=int, default=1000); p.add_argument("--seed", type=int, default=2027); p.add_argument("--shard", type=int, default=0); p.add_argument("--nshards", type=int, default=1); p.add_argument("--autocast", action="store_true")
        a = p.parse_args(); AC = a.autocast; build(a)
